# NimbusKart — Example tfvars for LocalStack development
# Copy to terraform.tfvars and adjust. Do not commit terraform.tfvars.

project     = "nimbuskart"
environment = "staging"
owner       = "platform-team"
aws_region  = "us-east-1"

vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.1.0/24", "10.20.2.0/24"]
availability_zones  = ["us-east-1a", "us-east-1b"]

# SSH: leave empty to disable ingress on port 22 (recommended)
# Set to your IP for local testing: "YOUR.IP.HERE/32"
ssh_allowed_cidr = ""

instance_type = "t3.micro"
